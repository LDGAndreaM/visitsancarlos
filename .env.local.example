# Copia este archivo a .env.local y llena los valores desde tu proyecto de Supabase
# (Project Settings > API en supabase.com).

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Dominio público del sitio (sin slash final). Se usa para metadata, canonical,
# sitemap.xml y robots.txt. Si no la defines, el código usa
# https://www.visitsancarlos.com.mx como valor por defecto.
NEXT_PUBLIC_SITE_URL=https://www.visitsancarlos.com.mx

# Buzón SMTP de Hostinger que envía los correos del formulario de contacto
# (el "De"; el "Para" cambia según el asunto — ver app/api/contact/route.ts).
# Host/puerto típicos de Hostinger: smtp.hostinger.com / 465.
CONTACT_SMTP_HOST=smtp.hostinger.com
CONTACT_SMTP_PORT=465
CONTACT_SMTP_USER=hola@visitsancarlos.com.mx
CONTACT_SMTP_PASS=la-contraseña-de-ese-buzón

# ID de medición de Google Analytics 4 (Admin > Flujos de datos > tu flujo web,
# empieza con "G-"). Si no la defines, el sitio simplemente no carga GA — no
# rompe nada.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Access token de producción de tu cuenta de Mercado Pago (Tu negocio >
# Configuración > Credenciales de producción, empieza con "APP_USR-"). Se usa
# en el servidor para crear la preferencia de pago y para verificar el pago
# cuando llega el webhook. NUNCA se manda al navegador.
MERCADOPAGO_ACCESS_TOKEN=APP_USR-tu-access-token

# Service role key de Supabase (Project Settings > API > service_role, NO la
# anon key). Solo la usa app/api/mercadopago/webhook/route.ts, en el servidor,
# para marcar una orden como pagada sin depender de la sesión del comprador
# (Mercado Pago llama a ese endpoint directo, sin cookies de usuario). NUNCA
# se manda al navegador ni se usa fuera de ese archivo.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
